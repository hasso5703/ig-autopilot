# Never commit credentials. This repo is public.
*.token
token.txt
.env
.env.*
secrets/

node_modules/
npm-debug.log*

# Local scratch renders (published media lives under media/<slug>/ and IS committed,
# because Instagram fetches those URLs server-side at publish time).
tmp/
scratch/

# Kokoro weights and virtualenv, re-downloaded per run (92 MB + 28 MB).
.cache/

# Raw acquired pictures. The composed slides are what Instagram fetches and they
# ARE committed; the sources behind them are cache, and their provenance is
# recorded in media/<slug>/imagery.json, which is committed.
media/*/src/

# The narration track, for the same reason. reel.mjs muxes it into reel.mp4,
# which IS committed and is the file Meta fetches; the loose wav is a 2.5 MB
# intermediate that any run regenerates from the post's own narration text.
media/*/voice.wav

# The reel's intermediate painted frames. reel.mjs encodes them into reel.mp4,
# which IS committed and is the file Meta fetches; the loose frames are ~550
# jpgs per run that any run repaints from the post spec. One run committed them
# by sweeping the whole media directory in.
media/*/_frames/

# reel2's intermediates, same reason as voice.wav above: everything here is
# muxed into reel.mp4, which IS committed. The bought assets that cost money
# (veo_*.mp4, still_*.jpg, shot_*.png) and words.json ARE committed so a
# retry pins them instead of buying twice.
media/*/voice2.wav
media/*/mix2.wav
media/*/seg2_*.mp4
media/*/reel2_nosub.mp4
media/*/reel2_sub.mp4
media/*/cap2.ass
media/*/concat2.txt
media/*/align.py
# The photo credit lines are written for ffmpeg's drawtext and burned into the
# segment; three of them reached the repo before this line existed.
media/*/seg2_*.credit.txt
media/*/seg2_*_parts.txt
